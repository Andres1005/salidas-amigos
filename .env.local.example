# Copia este archivo a .env.local y completa con los valores de tu proyecto
# de Supabase (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role key: NUNCA la expongas al cliente. Se usa solo en server
# actions para crear cuentas de usuario a partir de un código de invitación.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
